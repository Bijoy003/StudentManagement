{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "Chat": {
        "Endpoint": "http://localhost:11434",
        "Model": "qwen2.5:3b-instruct",
        "ApiKey": "unused",
        "Features": {
            "IncludeFullDocumentation": false,
            "IncludeRag": false,
            "MaxRagChunks": 3,
            "IncludeTools": true
        },
        "Mcp": {
            "Enabled": true,
            "Servers": {
                "jira": {
                    "Enabled": true,
                    "Transport": "stdio",
                    "Command": "python",
                    "Arguments": [ "-m", "uv", "tool", "run", "mcp-atlassian" ],
                    "Environment": {
                        "JIRA_URL": "",
                        "JIRA_USERNAME": "",
                        "JIRA_API_TOKEN": "",
                        "READ_ONLY_MODE": "true"
                    }
                },
                "github": {
                    "Enabled": false,
                    "Transport": "stdio",
                    "Command": "npx",
                    "Arguments": [ "-y", "@modelcontextprotocol/server-github" ],
                    "Environment": {
                        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
                    }
                }
            }
        }
    }
}
