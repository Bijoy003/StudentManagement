@{
    ViewData["Title"] = "Chat";
}

@section Breadcrumb
{
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
    <li class="breadcrumb-item active" aria-current="page">Chat</li>
}

@section Head
{
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

<div class="m-3">
    <h3><b>Chat Assistant</b></h3>
    <p class="text-muted">Ask about how to use the app or query live student, course, and enrollment data. Powered by your configured local AI model.</p>
</div>

<div class="container border rounded p-3 chat-container">
    <div id="chat-messages" class="border rounded p-3 mb-3 bg-light chat-messages">
    </div>

    <div id="chat-loading" class="text-muted mb-2 d-none">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Thinking...
    </div>

    <div id="chat-file-preview" class="d-none mb-2 p-2 border rounded bg-light">
        <small class="text-muted">Attached: <span class="file-name fw-bold"></span></small>
        <button type="button" class="btn-close btn-sm ms-2" onclick="clearFileAttachment()" aria-label="Remove"></button>
    </div>

    <div class="input-group">
        <input type="text" id="chat-input" class="form-control" placeholder="Type your message..." autocomplete="off" />
        <button type="button" id="chat-file-btn" class="btn btn-outline-secondary" title="Attach file" onclick="$('#chat-file-input').click()">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0V3z"/>
            </svg>
        </button>
        <input type="file" id="chat-file-input" class="d-none" accept=".txt,.docx,.pdf,.xlsx,.xls,.png,.jpg,.jpeg,.gif,.webp" />
        <button type="button" id="chat-send" class="btn btn-primary">Send</button>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
