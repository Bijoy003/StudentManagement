@using System.Security.Claims
@model ChatIndexViewModel

<button type="button" id="chat-widget-toggle" class="chat-widget-toggle btn btn-primary"
        aria-label="Chat assistant" aria-expanded="false" title="Chat assistant">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M5 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m4 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
        <path d="m2.165 15.803.02-.004c1.83-.363 2.948-.842 3.468-1.105A9 9 0 0 0 8 15c4.418 0 8-3.134 8-7s-3.582-7-8-7-8 3.134-8 7c0 1.76.743 3.37 1.97 4.6a10.4 10.4 0 0 1-.524 2.318l-.003.011a11 11 0 0 1-.244.637c-.079.186.074.394.273.362a22 22 0 0 0 .693-.125m.8-3.108a1 1 0 0 0-.287-.801C1.618 10.83 1 9.468 1 8c0-3.192 3.004-6 7-6s7 2.808 7 6-3.004 6-7 6a8 8 0 0 1-2.088-.272 1 1 0 0 0-.711.074c-.387.196-1.24.57-2.634.893a11 11 0 0 0 .398-2"/>
    </svg>
</button>

<div id="chat-widget-panel" class="chat-widget-panel d-none" data-chat-root
     data-user-id="@User.FindFirstValue(ClaimTypes.NameIdentifier)">
    <div class="chat-widget-header d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold">Chat Assistant <span class="badge bg-secondary align-middle">@Model.Role</span></span>
        <button type="button" id="chat-widget-close" class="btn-close" aria-label="Close chat"></button>
    </div>

    @Html.AntiForgeryToken()

    <p class="small text-muted mb-2">@Model.CapabilityHint</p>

    <div id="chat-quota" class="small text-muted mb-2"
         data-used="@Model.UsedToday" data-limit="@Model.DailyLimit" data-unlimited="@Model.Unlimited.ToString().ToLowerInvariant()">
        @if (!Model.ChatEnabled)
        {
            <span class="text-danger">Chat is currently disabled by the administrator.</span>
        }
        else if (Model.Unlimited)
        {
            <span>Token usage today: <span id="chat-quota-used">@Model.UsedToday</span> (unlimited — admin)</span>
        }
        else
        {
            <span>Token usage today: <span id="chat-quota-used">@Model.UsedToday</span> / @Model.DailyLimit</span>
        }
    </div>

    <div id="chat-messages" class="border rounded p-3 mb-3 bg-light chat-messages">
    </div>

    <div id="chat-loading" class="text-muted mb-2 d-none">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span id="chat-status-text">Working…</span>
    </div>

    <div id="chat-file-preview" class="d-none mb-2 p-2 border rounded bg-light">
        <small class="text-muted">Attached: <span class="file-name fw-bold"></span></small>
        <button type="button" class="btn-close btn-sm ms-2" onclick="clearFileAttachment()" aria-label="Remove"></button>
    </div>

    <div class="input-group">
        <input type="text" id="chat-input" class="form-control" placeholder="Type your message..." autocomplete="off" />
        <button type="button" id="chat-file-btn" class="btn btn-outline-secondary" title="Attach file" onclick="$('#chat-file-input').click()">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0V3z"/>
            </svg>
        </button>
        <input type="file" id="chat-file-input" class="d-none" accept=".txt,.docx,.pdf,.xlsx,.xls,.png,.jpg,.jpeg,.gif,.webp" />
        <button type="button" id="chat-send" class="btn btn-primary">Send</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
<script src="~/js/chat.js" asp-append-version="true"></script>
<script src="~/js/chat-widget.js" asp-append-version="true"></script>
