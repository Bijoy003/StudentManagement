@model StudentManagement.Web.Models.MyProfileViewModel

@section Breadcrumb
{
    <li class="breadcrumb-item">
        <a href="@Url.Action("Index", "Home")">Home</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        My Profile
    </li>
}

<h3>My Profile</h3>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">
        @ViewBag.SuccessMessage
    </div>
}

<div class="container border-2 p-4 mt-3">

    <form asp-action="Profile" method="post">

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label">Roles</label>
                <input value="@string.Join(", ", Model.Roles)"
                       class="form-control"
                       disabled />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </form>

    <hr />

    <div class="row align-items-center">
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Two-Factor Authentication
            </label>
            <div class="text-muted">
                Status:
                <strong>
                    @(Model.IsTwoFactorEnabled ? "Enabled" : "Disabled")
                </strong>
            </div>
        </div>

        <div class="col-md-6 text-end">

            @if (!Model.IsTwoFactorEnabled)
            {
                <form asp-action="Enable2FA"
                      asp-controller="Account"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-success">
                        Enable 2FA
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Disable2FA"
                      asp-controller="Account"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to disable 2FA?');">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Disable 2FA
                    </button>
                </form>
            }

        </div>
    </div>

    <hr />

    @if (Model.ShowAuthenticatorSetup && !Model.IsTwoFactorEnabled)
    {
        <div class="row mt-3">
            <div class="col-md-12">
                <h5>Set up an authenticator app</h5>

                <p class="text-muted">
                    Scan the QR code using Google Authenticator, Microsoft Authenticator,
                    or any compatible app.
                </p>
            </div>
        </div>

        <div class="row align-items-center mt-3">
            <div class="col-md-4 text-center">
                <img src="/Account/QrCode?uri=@Model.QrCodeUri"
                     alt="Authenticator QR Code"
                     class="img-fluid border p-2" />
            </div>

            <div class="col-md-8">
                <p class="mb-2">
                    If you can’t scan the QR code, enter this key manually:
                </p>

                <div class="alert alert-secondary font-monospace">
                    @Model.SharedKey
                </div>

                <form asp-action="ConfirmAuthenticator"
                      asp-controller="Account"
                      method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">
                            Verification code
                        </label>
                        <input asp-for="MfaCode"
                               class="form-control"
                               placeholder="6-digit code"
                               autocomplete="one-time-code"
                               required />
                    </div>

                    <button type="submit" class="btn btn-success">
                        Verify & Enable 2FA
                    </button>
                </form>
            </div>
        </div>

        <hr />
    }

    <div class="d-flex gap-2">
        <a asp-action="ChangePassword"
           asp-controller="Account"
           class="btn btn-outline-secondary">
            Change Password
        </a>
    </div>


</div>
