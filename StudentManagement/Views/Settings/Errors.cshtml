@model ErrorLogListViewModel

@{
    ViewData["Title"] = "Error Log";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Error Log</h2>
        <a class="btn btn-outline-secondary" asp-action="Settings">Chat Settings</a>
    </div>

    <form method="get" asp-action="Errors" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label" for="days">Window</label>
            <select id="days" name="days" class="form-select form-select-sm">
                @foreach (var option in new[] { 1, 7, 30, 90 })
                {
                    <option value="@option" selected="@(Model.Days == option)">Last @(option) day@(option == 1 ? "" : "s")</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label" for="source">Source contains</label>
            <input id="source" name="source" type="text" class="form-control form-control-sm" value="@Model.Source" placeholder="/Chat/Send" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        </div>
    </form>

    @if (Model.Entries.Count == 0)
    {
        <div class="alert alert-success">No errors recorded in this window.</div>
    }
    else
    {
        <p class="text-muted">Showing @Model.Entries.Count most recent error(s).</p>
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Time (UTC)</th>
                    <th>Source</th>
                    <th>Exception</th>
                    <th>Message</th>
                    <th>User</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td class="text-nowrap">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@entry.Source</td>
                        <td><code>@entry.ExceptionType</code></td>
                        <td style="max-width: 420px;">@entry.Message</td>
                        <td>@(entry.UserId ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(entry.StackTrace))
                            {
                                <details>
                                    <summary class="text-muted">stack trace</summary>
                                    <pre class="small mt-2" style="max-height: 300px; overflow: auto;">@entry.StackTrace</pre>
                                </details>
                            }
                            @if (!string.IsNullOrEmpty(entry.TraceId))
                            {
                                <div class="small text-muted">trace: @entry.TraceId</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>