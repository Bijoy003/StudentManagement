@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "_Layout";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
    <li class="breadcrumb-item active">Teacher Dashboard</li>
}

<h2 class="mb-4">Teacher Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">My Courses</h5>
                <h3 class="text-primary">@ViewBag.CourseCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Total Students</h5>
                <h3 class="text-success">@ViewBag.TotalStudents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">Quick Actions</h5>
                <a href="@Url.Action("ManageCourses", "Teacher")" class="btn btn-primary btn-sm mb-1">Manage Courses</a>
                <a href="@Url.Action("ManageGrades", "Teacher")" class="btn btn-success btn-sm mb-1">Manage Grades</a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">My Courses</h5>
    </div>
    <div class="card-body">
        @if (ViewBag.Courses != null && ((List<StudentManagement.Domain.Entities.Course>)ViewBag.Courses).Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Course Name</th>
                        <th>Credits</th>
                        <th>Students Enrolled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in (List<StudentManagement.Domain.Entities.Course>)ViewBag.Courses)
                    {
                        <tr>
                            <td>@course.Name</td>
                            <td>@course.Credits</td>
                            <td>@(course.Enrollments?.Count ?? 0)</td>
                            <td>
                                <a href="@Url.Action("EditCourse", "Teacher", new { id = course.Id })" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a href="@Url.Action("CourseStudents", "Teacher", new { courseId = course.Id })" class="btn btn-sm btn-outline-info">View Students</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No courses assigned yet.</p>
            <a href="@Url.Action("CreateCourse", "Teacher")" class="btn btn-primary">Add New Course</a>
        }
    </div>
</div>
