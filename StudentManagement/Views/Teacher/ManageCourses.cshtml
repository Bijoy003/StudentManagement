@model List<StudentManagement.Domain.Entities.Course>
@{
    ViewData["Title"] = "Manage Courses";
    Layout = "_Layout";
}

@section Breadcrumb {
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Teacher")">Teacher Dashboard</a></li>
    <li class="breadcrumb-item active">Manage Courses</li>
}

<h2 class="mb-4">Manage Courses</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<a href="@Url.Action("CreateCourse", "Teacher")" class="btn btn-primary mb-3">Add New Course</a>

@* Token source for the deleteCourse() fetch below (DeleteCourse requires an antiforgery token
   sent via the RequestVerificationToken header). *@
<form id="deleteForm" class="d-none">@Html.AntiForgeryToken()</form>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover" id="coursesTable">
        <thead>
            <tr>
                <th>Course Name</th>
                <th>Credits</th>
                <th>Students Enrolled</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.Name</td>
                    <td>@course.Credits</td>
                    <td>@(course.Enrollments?.Count ?? 0)</td>
                    <td>
                        <a href="@Url.Action("EditCourse", "Teacher", new { id = course.Id })" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a href="@Url.Action("CourseStudents", "Teacher", new { courseId = course.Id })" class="btn btn-sm btn-outline-info">Students</a>
                        @* data-* attributes are Razor-attribute-encoded, so a crafted course
                           name cannot break out into JS (the old inline string interpolation
                           allowed stored XSS and broke on apostrophes). *@
                        <button data-id="@course.Id" data-name="@course.Name" onclick="deleteCourse(this)" class="btn btn-sm btn-outline-danger">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No courses found. Add your first course.</p>
}

@section Scripts {
    <script>
        function deleteCourse(el) {
            const id = el.dataset.id;
            const name = el.dataset.name;
            if (confirm('Are you sure you want to delete the course "' + name + '"?')) {
                fetch('/Teacher/DeleteCourse?id=' + id, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Error deleting course');
                    }
                })
                .catch(error => {
                    alert('Error: ' + error);
                });
            }
        }
    </script>
}
