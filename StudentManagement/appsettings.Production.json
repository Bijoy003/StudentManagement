{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "ConnectionStrings": {
        "DatabaseConnection": "server=BHUGOLLAP\\MSSQLSERVER2019;database=StudentManagement;Trusted_Connection=True;TrustServerCertificate=True;"
    },

    "Chat": {
        "Endpoint": "http://host.docker.internal:1234",
        "Model": "qwen2.5:3b-instruct",
        "ApiKey": "unused",
        "Features": {
            "IncludeFullDocumentation": true,
            "IncludeRag": true,
            "MaxRagChunks": 3,
