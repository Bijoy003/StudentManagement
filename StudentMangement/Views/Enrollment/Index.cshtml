@model IEnumerable<Enrollment>
@section Breadcrumb
{
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
    <li class="breadcrumb-item active" aria-current="page">Enrollments</li>
}

<h3>Enrollments</h3>
<table class="table table-striped">
    <tr><th>ID</th><th>Student</th><th>Course</th><th>Grade</th></tr>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Id</td>
            <td>@e.Student?.Name</td>
            <td>@e.Course?.Name</td>
            <td>@e.Grade</td>
        </tr>
    }
</table>

<a class="btn btn-outline-success mb-3" href="@Url.Action("Create", "Course")">Create New Course</a>
<a class="btn btn-outline-success mb-3" href="@Url.Action("Create", "Enrollment")">Create New Enrollment</a>
