@model StudentMangement.Models.Enrollment

@{
    ViewData["Title"] = "Create Enrollment";
}

@section Breadcrumb
{
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Enrollment")">Enrollments</a></li>
    <li class="breadcrumb-item active" aria-current="page">Create</li>
}

<form class="p-3 mt-2" id="enrollment-form" onsubmit="saveEnrollment(event)">
    <input type="hidden" id="Id" value="@Model?.Id" />

    <div class="p-3">
        <div class="row gap-3 pt-3">
            <div class="col">
                <label class="mb-2">Student</label>
                <select id="studentId" class="form-select">
                    @foreach (var student in ViewBag.Students)
                    {
                        <option value="@student.Id">@student.Name</option>
                    }
                </select>
            </div>
            <div class="col">
                <label class="mb-2">Course</label>
                <select id="courseId" class="form-select">
                    @foreach (var course in ViewBag.Courses)
                    {
                        <option value="@course.Id">@course.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row gap-3 pt-3">
            <div class="col">
                <label class="mb-2">Grade</label>
                <input type="number" step="0.01" class="form-control" id="grade" value="@Model?.Grade" />
            </div>
        </div>
    </div>

    <div class="d-flex gap-3 mt-3">
        <button type="button" class="btn btn-outline-danger" onclick="window.location.href='@Url.Action("Index", "Enrollment")'">Cancel</button>
        <button type="submit" class="btn btn-outline-success">Save</button>
    </div>
</form>

@section Scripts
{
    <script src="~/js/enrollment.js" asp-append-version="true"></script>
}
