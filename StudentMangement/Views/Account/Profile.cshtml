@model MyProfileViewModel

@section Breadcrumb
{
    <li class="breadcrumb-item">
        <a href="@Url.Action("Index", "Home")">Home</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        My Profile
    </li>
}

<h3>My Profile</h3>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">
        @ViewBag.SuccessMessage
    </div>
}

<div class="container border-2 p-4 mt-3">

    <form asp-action="Profile" method="post">

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>

            <div class="col-md-6">
                <label class="form-label">Roles</label>
                <input value="@string.Join(", ", Model.Roles)"
                       class="form-control"
                       disabled />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </form>

    <hr />

    <div class="row align-items-center">
        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Two-Factor Authentication
            </label>
            <div class="text-muted">
                Status:
                <strong>
                    @(Model.IsTwoFactorEnabled ? "Enabled" : "Disabled")
                </strong>
            </div>
        </div>

        <div class="col-md-6 text-end">

            @if (!Model.IsTwoFactorEnabled)
            {
                <form asp-action="Enable2FA"
                      asp-controller="Account"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-success">
                        Enable 2FA
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Disable2FA"
                      asp-controller="Account"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to disable 2FA?');">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Disable 2FA
                    </button>
                </form>
            }

        </div>
    </div>

    <hr />

    <div class="d-flex gap-2">
        <a asp-action="ChangePassword"
           asp-controller="Account"
           class="btn btn-outline-secondary">
            Change Password
        </a>
    </div>


</div>
