@model StudentManagement.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-sm p-4" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Student Management Login</h2>
            <p class="text-muted">Enter your credentials to access the Home Page</p>
        </div>

        <form asp-action="Login" method="post">
            <!-- Email Input -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Password Input -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Remember Me Checkbox -->
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" id="RememberMeCheck" />
                <label asp-for="RememberMe" class="form-check-label" for="RememberMeCheck">
                    Remember Me
                </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100">Login</button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">Forgot your password? <a href="#">Reset here</a></small>
        </div>
    </div>
</div>
