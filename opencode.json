{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B (local)"
        },
        "google/gemma-4-26b-a4b": {
          "name": "Gemma 4 26B (local)"
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B QAT (local)"
        },
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B (local)"
        },
        "qwen/qwen-3.6-35b-a3b": {
          "name": "Qwen 3.6 35B A3B (local)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (local)"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (local)"
        },
        "qwen3-coder": {
          "name": "Qwen 3 Coder (local)"
        }
      }
    },
    "dashscope": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Model Studio PAYG Beijing (BROKEN - needs CN sk- key, env key is intl)",
      "options": {
        "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "apiKey": "{env:DASHSCOPE_API_KEY}"
      },
      "models": {
        "qwen3.8-max": { "name": "Qwen3.8 Max" },
        "qwen3.8-flash": { "name": "Qwen3.8 Flash" },
        "qwen3-coder-flash": { "name": "Qwen3 Coder Flash" },
        "glm-5.3": { "name": "GLM-5.3" },
        "deepseek-v4.1-flash-1017": { "name": "DeepSeek V4.1 Flash (half price 22:00-08:00 UTC+8)" },
        "deepseek-v4-pro-0813": { "name": "DeepSeek V4 Pro 0813 (half price 22:00-08:00 UTC+8)" }
      }
    }
  },
  "permission": {
    "skill": "allow",
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "todowrite": "allow"
  },
  "model": "alibaba-token-plan/qwen3.8-max"
}